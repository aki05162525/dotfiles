{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "hono-skill@hono-skill": true,
    "vercel@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "hono-skill": {
      "source": {
        "source": "github",
        "repo": "yusukebe/hono-skill"
      }
    }
  },
  "env": {
    "GIT_CONFIG_COUNT": "2",
    "GIT_CONFIG_KEY_0": "gpg.ssh.program",
    "GIT_CONFIG_VALUE_0": "ssh-keygen",
    "GIT_CONFIG_KEY_1": "user.signingkey",
    "GIT_CONFIG_VALUE_1": "~/.ssh/agent_signing.pub"
  },
  "language": "Japanese",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "switchModelsOnFlag": false
}
